#!/bin/sh
# Fails the commit if a renderer's output changed: re-renders the train split
# once and compares pixel hashes with bench/baseline-train.json. Only runs when
# staged files can affect rendering. Skip with `git commit --no-verify`.
#
# It checks the staged snapshot (exported to a temp dir), not the working tree,
# so unstaged edits can neither fail nor pass the commit.
#
# An intentional visual change: re-record the baseline in the same commit with
#   npm run bench -- --split=train --save=bench/baseline-train.json

if ! git diff --cached --name-only | grep -qE '^(src/renderers/|src/workers/|src/utils/(math|image|noise|field|canvas|blur|index)\.js|scripts/(bench|cli-renderers)\.js|bench/)'; then
  exit 0
fi

if ! node -e "import('canvas')" 2>/dev/null; then
  echo "pre-commit: skipping the renderer hash check (the optional 'canvas' package isn't installed)"
  exit 0
fi

root=$(git rev-parse --show-toplevel)
snapshot=$(mktemp -d)
log="$snapshot.log"
trap 'rm -rf "$snapshot"' EXIT
git checkout-index -a --prefix="$snapshot/"
ln -s "$root/node_modules" "$snapshot/node_modules"

echo "pre-commit: renderer files changed, checking the staged output hashes (~40s)..."
if ! (cd "$snapshot" && node scripts/bench.js --split=train --reps=1 --check=bench/baseline-train.json) > "$log" 2>&1; then
  grep -E "MISMATCH|Error" "$log"
  echo "pre-commit: renderer output changed (full log: $log)"
  exit 1
fi
echo "pre-commit: all renderer hashes match"
